# KHÔNG commit local.properties (chứa sdk.dir và admin.emails)
local.properties

# Keystore và mật khẩu keystore không được commit
*.jks
*.keystore
keystore.properties

# APK/AAB dựng ra không commit
*.apk
*.aab
output.json

# google-services.json chứa khóa API Firebase của dự án -> KHÔNG commit (Cột mốc 5: ẩn khóa API).
# Repo chỉ có app/google-services.json.example (giá trị giả). Khi chưa có file thật,
# Gradle tự chép bản mẫu để project build được. Muốn đăng nhập Firebase thật: đặt file tải từ
# Firebase Console vào app/google-services.json (xem API_SETUP.md).
app/google-services.json
